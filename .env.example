# Run one model:  python main.py smolvlm2-500m
# Run all enabled: python main.py
# List models:     python main.py --list

# Camera stream (file path also works, e.g. videos/fire_smoke.mp4)
RTSP_URL=rtsp://localhost:8554/live/video

LOG_FILE_PATH=logs/events.log
RECONNECT_DELAY=5

# Shared VLM benchmark settings
VLM_TEST_FPS=0.2
VLM_PROMPT=You are analyzing a security camera frame. Reply with exactly two tokens in this format: fire:yes or fire:no, smoke:yes or smoke:no
VLM_ALERT_COOLDOWN=30

VLM_BENCHMARK_ENABLED=true
VLM_BENCHMARK_LOG_PATH=logs/vlm_benchmark.csv
VLM_BENCHMARK_RAISE_ALERTS=false

YOLO_ENABLED=true
YOLO_FPS=2

# Enable models to compare in parallel (each runs in its own thread)
SMOLVLM2_500M_ENABLED=true
SMOLVLM2_500M_MODEL=HuggingFaceTB/SmolVLM2-500M-Video-Instruct

SMOLVLM2_256M_ENABLED=true
SMOLVLM2_256M_MODEL=HuggingFaceTB/SmolVLM2-256M-Video-Instruct

INTERNVL3_ENABLED=true
INTERNVL3_MODEL=OpenGVLab/InternVL3-1B-hf

# GGUF via llama-server (start separately: llama-server -hf ggml-org/SmolVLM2-256M-Video-Instruct-GGUF)
GGUF_ENABLED=false
GGUF_MODEL_ID=ggml-org/SmolVLM2-256M-Video-Instruct-GGUF
GGUF_SERVER_URL=http://127.0.0.1:8080
GGUF_TIMEOUT=120

# Alert engine (SMTP) - leave empty until ready
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
ALERT_TO_EMAILS=
